rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /trades/{tradeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /winners/{winnerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Phone verification state is written only by trusted backend code.
      match /security/phone {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Replay/idempotency records for phone verification are server-only.
    match /verificationExchanges/{exchangeId} {
      allow read, write: if false;
    }
  }
}
